<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MiniDashboard.Avalonia.Converters"
        xmlns:grid="clr-namespace:MiniDashboard.Avalonia.Grid"
        xmlns:tiles="clr-namespace:MiniDashboard.Avalonia.Tiles"
        x:Class="MiniDashboard.Avalonia.Themes.MiniDashboardStyles">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MiniDashboard.Avalonia/Themes/Colors.axaml" />
                <ResourceInclude Source="avares://MiniDashboard.Avalonia/Themes/Controls/DashboardChrome.axaml" />
                <ResourceInclude Source="avares://MiniDashboard.Avalonia/Themes/Controls/DashboardHeader.axaml" />
                <ResourceInclude Source="avares://MiniDashboard.Avalonia/Themes/Controls/DashboardResizeGrip.axaml" />
                <ResourceInclude Source="avares://MiniDashboard.Avalonia/Themes/Controls/Tile.axaml" />
                <ResourceInclude Source="avares://MiniDashboard.Avalonia/Themes/Controls/DashboardMatrix.axaml" />
                <ResourceInclude Source="avares://MiniDashboard.Avalonia/Themes/Controls/TextTile.axaml" />
                <ResourceInclude Source="avares://MiniDashboard.Avalonia/Themes/Controls/ImageTile.axaml" />
                <ResourceInclude Source="avares://MiniDashboard.Avalonia/Themes/Controls/TableViewTile.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:TopCornersOnlyCornerRadiusConverter x:Key="TopCornersOnlyConverter" />

            <!-- Keep target shading constant instead of inheriting the host theme's button hover fill. -->
            <ControlTheme x:Key="DashboardTargetPickerButtonTheme" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource DashboardTargetOverlayBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TileForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^.pick-eligible:pointerover">
                    <Setter Property="Background" Value="{DynamicResource DashboardTargetHoverOverlayBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DashboardTargetHighlightBrush}" />
                </Style>
                <Style Selector="^.pick-eligible:focus-visible">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DashboardTargetHighlightBrush}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Global DashboardPanel styling using themed brushes -->
    <Style Selector=":is(grid|DashboardPanel)">
        <Setter Property="ColumnFillA" Value="{DynamicResource DashboardColumnFillABrush}" />
        <Setter Property="ColumnFillB" Value="{DynamicResource DashboardColumnFillBBrush}" />
        <Setter Property="RowFill" Value="{DynamicResource DashboardRowFillBrush}" />
        <Setter Property="GridLineBrush" Value="{DynamicResource DashboardGridLineBrush}" />
        <Setter Property="TileMargin" Value="3" />
        <Setter Property="TileCornerRadius" Value="{DynamicResource DashboardCellCornerRadius}" />
        <Setter Property="TileBorderBrush" Value="{DynamicResource TileBorderBrush}" />
        <Setter Property="TileBorderThickness" Value="1" />
    </Style>

    <!-- Tiles bind Tile properties to global DashboardPanel properties -->
    <Style Selector=":is(grid|DashboardPanel) > :is(tiles|Tile)">
        <Setter Property="CornerRadius"
                Value="{Binding TileCornerRadius, RelativeSource={RelativeSource AncestorType=grid:DashboardPanel}}" />
        <Setter Property="BorderBrush"
                Value="{Binding TileBorderBrush, RelativeSource={RelativeSource AncestorType=grid:DashboardPanel}}" />
        <Setter Property="BorderThickness"
                Value="{Binding TileBorderThickness, RelativeSource={RelativeSource AncestorType=grid:DashboardPanel}}" />
    </Style>
    <Style Selector=":is(grid|DashboardPanel) > :is(tiles|Tile) /template/ tiles|DashboardHeader">
        <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <Style Selector=":is(tiles|Tile):overlay-actions /template/ Button#PART_OverlayActions">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector=":is(tiles|Tile):pointerover /template/ Button#PART_OverlayActions">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector=":is(tiles|Tile):focus-within /template/ Button#PART_OverlayActions">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector=":is(tiles|Tile):empty /template/ Button#PART_Add">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Resize grip is subtle at rest and reveals on hover to guide the eye to the active corner.
         Uses :is() so it applies to every tile type (TextTile, ImageTile, PlotTile, TreeDataGridTile, ...) across all assemblies. -->
    <Style Selector=":is(tiles|Tile) /template/ Thumb#PART_ResizeThumb">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(tiles|Tile):pointerover /template/ Thumb#PART_ResizeThumb">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector=":is(GridSplitter).matrix-splitter:focus-visible /template/ Border#PART_HitTarget">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileForegroundBrush}" />
    </Style>
    <Style Selector=":is(GridSplitter).matrix-splitter">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector=":is(GridSplitter).matrix-splitter:pointerover">
        <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector=":is(GridSplitter).matrix-splitter:focus-visible">
        <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector=":is(Button).matrix-boundary-action">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource TileHeaderBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TileForegroundBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
</Styles>