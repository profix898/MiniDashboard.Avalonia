<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared visual metrics; applications can override these resource keys. -->
    <CornerRadius x:Key="DashboardCellCornerRadius">6</CornerRadius>
    <Thickness x:Key="DashboardContentPadding">6</Thickness>
    <x:Double x:Key="DashboardHeaderMinHeight">32</x:Double>
    <x:Double x:Key="DashboardActionSize">28</x:Double>
    <x:String x:Key="DashboardContentActionsLabel">Content actions</x:String>
    <x:String x:Key="DashboardAddContentLabel">+ Add content</x:String>
    <ControlTheme x:Key="DashboardActionButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Content" Value="⋯" />
        <Setter Property="Width" Value="{DynamicResource DashboardActionSize}" />
        <Setter Property="Height" Value="{DynamicResource DashboardActionSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource DashboardContentActionsLabel}" />
        <Setter Property="ToolTip.Tip" Value="{DynamicResource DashboardContentActionsLabel}" />
        <Style Selector="^:focus">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:flyout-open">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>
</ResourceDictionary>