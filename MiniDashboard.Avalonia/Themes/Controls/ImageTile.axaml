<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:grid="clr-namespace:MiniDashboard.Avalonia.Grid;assembly=MiniDashboard.Avalonia"
                    xmlns:tiles="clr-namespace:MiniDashboard.Avalonia.Tiles">

    <ControlTheme x:Key="{x:Type tiles:ImageTile}" TargetType="tiles:ImageTile"
                  BasedOn="{StaticResource {x:Type tiles:Tile}}">
        <Setter Property="TileHeader" Value="Image" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding TileBackground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <tiles:DashboardHeader Grid.Row="0" x:Name="PART_Header"
                                               IsVisible="{TemplateBinding IsHeaderPresented}"
                                               Title="{TemplateBinding TileHeader}"
                                               IsPlacementValid="{TemplateBinding IsPlacementValid}"
                                               Content="{TemplateBinding HeaderContent}"
                                               ContentTemplate="{TemplateBinding HeaderTemplate}"
                                               Actions="{TemplateBinding EffectiveHeaderActions}"
                                               CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopCornersOnlyConverter}}"
                                               grid:DraggableBehavior.IsEnabled="True" />

                        <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                            <Image Source="{TemplateBinding ImageSource}"
                                   Stretch="{TemplateBinding Stretch}"
                                   StretchDirection="{TemplateBinding StretchDirection}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Border>

                        <Thumb Grid.Row="1" x:Name="PART_ResizeThumb"
                               Theme="{StaticResource DashboardResizeGripTheme}"
                               IsVisible="{TemplateBinding IsResizeGripVisible}" />

                        <Button Grid.RowSpan="2" x:Name="PART_OverlayActions"
                                Theme="{StaticResource DashboardActionButtonTheme}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsVisible="False"
                                Flyout="{TemplateBinding EffectiveHeaderActions}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>