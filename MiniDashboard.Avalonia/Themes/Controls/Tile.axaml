<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MiniDashboard.Avalonia">

    <!-- Base look for Tile -->
    <ControlTheme x:Key="{x:Type controls:Tile}" TargetType="controls:Tile">
        <Setter Property="TileBackground" Value="{DynamicResource TileBackgroundBrush}" />
        <Setter Property="TileForeground" Value="{DynamicResource TileForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DashboardCellCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource DashboardContentPadding}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding TileBackground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <controls:DashboardHeader Grid.Row="0" x:Name="PART_Header"
                                                  IsVisible="{TemplateBinding IsHeaderPresented}"
                                                  Title="{TemplateBinding TileHeader}"
                                                  IsPlacementValid="{TemplateBinding IsPlacementValid}"
                                                  Content="{TemplateBinding HeaderContent}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  Actions="{TemplateBinding EffectiveHeaderActions}"
                                                  CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopCornersOnlyConverter}}"
                                                  controls:DraggableBehavior.IsEnabled="True" />

                        <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>

                        <Button Grid.Row="1" x:Name="PART_Add"
                                Content="{DynamicResource DashboardAddContentLabel}" IsVisible="False"
                                MinHeight="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Flyout="{TemplateBinding AddContentActions}" />
                        <Thumb Grid.Row="1" x:Name="PART_ResizeThumb"
                               Theme="{StaticResource DashboardResizeGripTheme}"
                               IsVisible="{TemplateBinding IsResizeGripVisible}" />

                        <Button Grid.RowSpan="2" x:Name="PART_OverlayActions"
                                Theme="{StaticResource DashboardActionButtonTheme}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsVisible="False"
                                Flyout="{TemplateBinding EffectiveHeaderActions}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>