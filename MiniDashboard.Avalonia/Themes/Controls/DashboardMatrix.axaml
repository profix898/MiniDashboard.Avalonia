<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:matrix="clr-namespace:MiniDashboard.Avalonia.Matrix">
    <ControlTheme x:Key="{x:Type matrix:DashboardMatrix}" TargetType="matrix:DashboardMatrix">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding LayoutPadding}">
                    <!-- Native star rounding can extend the final cell by one pixel.
                         Keep that border visible in the surrounding padding. -->
                    <Grid x:Name="PART_Grid" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>