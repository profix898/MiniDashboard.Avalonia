<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="clr-namespace:MiniDashboard.Avalonia;assembly=MiniDashboard.Avalonia"
                    xmlns:scottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
                    xmlns:charts="clr-namespace:MiniDashboard.Avalonia.ScottPlot">

    <ControlTheme x:Key="{x:Type charts:PlotTile}" TargetType="charts:PlotTile"
                  BasedOn="{StaticResource {x:Type base:Tile}}">
        <Setter Property="TileHeader" Value="Chart" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding TileBackground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <base:DashboardHeader Grid.Row="0" x:Name="PART_Header"
                                              IsVisible="{TemplateBinding IsHeaderPresented}"
                                              Title="{TemplateBinding TileHeader}"
                                              IsPlacementValid="{TemplateBinding IsPlacementValid}"
                                              Content="{TemplateBinding HeaderContent}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Actions="{TemplateBinding EffectiveHeaderActions}"
                                              CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopCornersOnlyConverter}}"
                                              base:DraggableBehavior.IsEnabled="True" />

                        <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                            <scottPlot:AvaPlot x:Name="PART_AvaPlot" />
                        </Border>

                        <Thumb Grid.Row="1" x:Name="PART_ResizeThumb"
                               Theme="{StaticResource DashboardResizeGripTheme}"
                               IsVisible="{TemplateBinding IsResizeGripVisible}" />

                        <Button Grid.RowSpan="2" x:Name="PART_OverlayActions"
                                Theme="{StaticResource DashboardActionButtonTheme}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsVisible="False"
                                Flyout="{TemplateBinding EffectiveHeaderActions}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>